{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eclipse",
  "version": "1.0.0",
  "identifier": "Eclipse.AccountManager",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../src/renderer/assets/icon.ico", "../src/renderer/assets/icon.png"]
  }
}

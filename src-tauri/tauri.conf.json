{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eclipse",
  "version": "2.3.0",
  "identifier": "Eclipse.AccountManager",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../src/renderer/assets/icon.ico", "../src/renderer/assets/icon.png"],
    "publisher": "Eclipse",
    "resources": {
      "../src/renderer/*.html": "src/renderer/",
      "../src/renderer/*.css": "src/renderer/",
      "../src/renderer/*.js": "src/renderer/",
      "../src/renderer/assets/*.png": "src/renderer/assets/",
      "../src/integration/overlay/toggle.html": "src/integration/overlay/toggle.html",
      "../src/integration/overlay/toggle.css": "src/integration/overlay/toggle.css",
      "../src/integration/overlay/toggle.js": "src/integration/overlay/toggle.js",
      "../src/integration/overlay/toggle-check.svg": "src/integration/overlay/toggle-check.svg",
      "../src/integration/overlay/cover.html": "src/integration/overlay/cover.html",
      "../src/integration/overlay/cover.css": "src/integration/overlay/cover.css",
      "../node_modules/@fontsource/inter/400.css": "node_modules/@fontsource/inter/400.css",
      "../node_modules/@fontsource/inter/files/inter-*-400-normal.woff2": "node_modules/@fontsource/inter/files/",
      "../node_modules/@fontsource/inter/files/inter-*-400-normal.woff": "node_modules/@fontsource/inter/files/",
      "../node_modules/@fontsource/teko/500.css": "node_modules/@fontsource/teko/500.css",
      "../node_modules/@fontsource/teko/600.css": "node_modules/@fontsource/teko/600.css",
      "../node_modules/@fontsource/teko/files/teko-*-500-normal.woff2": "node_modules/@fontsource/teko/files/",
      "../node_modules/@fontsource/teko/files/teko-*-500-normal.woff": "node_modules/@fontsource/teko/files/",
      "../node_modules/@fontsource/teko/files/teko-*-600-normal.woff2": "node_modules/@fontsource/teko/files/",
      "../node_modules/@fontsource/teko/files/teko-*-600-normal.woff": "node_modules/@fontsource/teko/files/",
      "../src/platform/windows/login.ps1": "src/platform/windows/login.ps1",
      "../src/platform/windows/windowGuard.ps1": "src/platform/windows/windowGuard.ps1",
      "../src/platform/windows/riotWindowObserver.ps1": "src/platform/windows/riotWindowObserver.ps1"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "../src/renderer/assets/icon.ico",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}

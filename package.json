{
  "name": "riot-account-manager",
  "version": "1.0.0",
  "description": "Account switcher for League of Legends, TFT and VALORANT",
  "main": "src/main/index.js",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "start:riot-login": "electron . --riot-login",
    "start:private": "electron . --private-client",
    "test": "node --test \"test/**/*.test.js\"",
    "preview": "node scripts/dev/preview-server.js",
    "preview:riot-login": "electron scripts/dev/preview-riot-integration.js",
    "integration:prepare-private": "node scripts/integration/prepare-private-riot-host.js",
    "integration:probe-private": "electron scripts/integration/probe-private-riot-host.js",
    "legacy:prepare-install": "node scripts/legacy/prepare-riot-integration.js"
  },
  "devDependencies": {
    "electron": "44.9.3"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/teko": "^5.3.0"
  }
}
